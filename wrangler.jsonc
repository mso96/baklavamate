{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "baklavamate",
  "compatibility_date": "2026-10-19",
  "build": {
    "command": "npm run build"
  },
  "assets": {
    "directory": "./dist/client",
    "not_found_handling": "404-page",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "main": "cloudflare/worker.js",
  "observability": {
    "enabled": true
  }
}
